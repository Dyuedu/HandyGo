# ============================================
# DATABASE CONFIGURATION
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/handygo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ============================================
# REDIS CONFIGURATION
# ============================================
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET_KEY=your-very-long-secret-key-for-jwt-token-minimum-32-characters
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================
# Hướng dẫn: 
# 1. Đăng nhập vào Gmail account
# 2. Truy cập https://myaccount.google.com/apppasswords
# 3. Tạo mật khẩu ứng dụng mới cho Gmail
# 4. Copy mật khẩu ứng dụng vào SPRING_MAIL_PASSWORD
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password
SPRING_MAIL_FROM=noreply@handygo.com

# ============================================
# GOOGLE OAUTH2 CONFIGURATION
# ============================================
# Hướng dẫn: https://developers.google.com/identity/protocols/oauth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# VNPAY CONFIGURATION
# ============================================
# VNPay sandbox credentials (for testing)
VNPAY_TMN_CODE=2MC6Z5TR
VNPAY_SECRET_KEY=TJNPYQFBG7GCCJQDDR4P5U7011TMYXA0
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://api.sandbox.vnpayment.vn
VNPAY_RETURN_URL=http://localhost:3000/payment/callback
VNPAY_NOTIFY_URL=http://your-domain.com/api/v1/payment/vnpay-callback

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
# Hướng dẫn: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=handygo

# ============================================
# GOOGLE MAPS CONFIGURATION
# ============================================
# Hướng dẫn: https://developers.google.com/maps/documentation/javascript/get-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# APPLICATION URLS
# ============================================
APP_BASE_URL=http://localhost:8080
APP_FE_URL=http://localhost:3000
APP_NAME=HandyGo
APP_DESCRIPTION=Platform kết nối khách hàng với các nhân viên dịch vụ

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development
# ENVIRONMENT=production
